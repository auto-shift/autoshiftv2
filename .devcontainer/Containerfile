FROM registry.access.redhat.com/ubi10/ubi

# A release channel, not a version: oc self-updates to the latest 4.22 patch on every rebuild.
# The MINOR is frozen here and Renovate cannot track a channel name. Keep it aligned with
# `openshift-version` in autoshift/values/clustersets/_example.yaml (the version the fleet is
# provisioned and upgraded to); an oc more than one minor from the cluster is unsupported skew.
ARG OCP_VERSION=stable-4.22
# Helm and kustomize are COMPATIBILITY pins, not "keep current" pins: they must match what the
# Red Hat OpenShift GitOps repo-server renders with, or local output diverges from the cluster.
# GitOps 1.21 ships Helm 3.19.4 and kustomize 5.8.1. Bump these when gitops-channel moves, and
# update allowedVersions in renovate.json at the same time.
# renovate: datasource=github-releases depName=helm/helm
ARG HELM_VERSION=v3.19.4
# renovate: datasource=github-releases depName=gitleaks/gitleaks extractVersion=^v(?<version>.+)$
ARG GITLEAKS_VERSION=8.24.3
# renovate: datasource=github-releases depName=errata-ai/vale extractVersion=^v(?<version>.+)$
ARG VALE_VERSION=3.17.1

# Go is NOT pinned here. It is read from tools/go.mod at build time so the image cannot drift from
# what the module requires and from what CI resolves through `go-version-file: tools/go.mod`.
# Zensical is likewise read from docs/requirements.txt. One pin per tool, one place.

LABEL description="A container for administrating OpenShift Clusters."

# Install dependencies and yq from EPEL
RUN dnf -y update &&\
    dnf -y install \
        bash-completion \
        git \
        jq \
        make \
        ncurses \
        procps-ng \
        python3-pip \
        python3-pyyaml \
        https://dl.fedoraproject.org/pub/epel/epel-release-latest-10.noarch.rpm &&\
    dnf -y install yq &&\
    dnf clean all

# Download oc from Red Hat mirrors and helm from official releases
RUN curl -sL https://mirror.openshift.com/pub/openshift-v4/clients/ocp/${OCP_VERSION}/openshift-client-linux.tar.gz \
    | tar xvzf - -C /usr/local/bin &&\
    chmod +x /usr/local/bin/oc &&\
    oc completion bash > /etc/bash_completion.d/oc &&\
    chmod +x /usr/local/bin/kubectl &&\
    curl -sL https://get.helm.sh/helm-${HELM_VERSION}-linux-amd64.tar.gz | tar xz -C /tmp &&\
    mv /tmp/linux-amd64/helm /usr/local/bin/helm &&\
    chmod +x /usr/local/bin/helm &&\
    rm -rf /tmp/linux-amd64

# Install Go at the version tools/go.mod declares
COPY tools/go.mod /tmp/go.mod
RUN GO_VERSION="$(awk '/^go /{print $2; exit}' /tmp/go.mod)" &&\
    echo "Installing Go ${GO_VERSION} (from tools/go.mod)" &&\
    curl -sL "https://dl.google.com/go/go${GO_VERSION}.linux-amd64.tar.gz" | tar xz -C /usr/local &&\
    rm -f /tmp/go.mod

ENV PATH="/usr/local/go/bin:${PATH}"

# Install gitleaks
RUN curl -sL https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz \
    | tar xz -C /usr/local/bin gitleaks &&\
    chmod +x /usr/local/bin/gitleaks

# Install Vale. The rule package is NOT baked in: `vale sync` fetches it into the workspace, so the
# image does not freeze a style version.
RUN curl -sfL "https://github.com/errata-ai/vale/releases/download/v${VALE_VERSION}/vale_${VALE_VERSION}_Linux_64-bit.tar.gz" \
    | tar xz -C /usr/local/bin vale &&\
    chmod +x /usr/local/bin/vale

# Install the documentation site generator at the version docs/requirements.txt pins.
# Zensical requires Python >=3.10, which ubi10 satisfies by default (3.12). On ubi9 this needed an
# explicit python3.12, because pip on 3.9 resolves back to zensical 0.0.2 and the exact pin fails.
# The version check is a build-time smoke test: fail here rather than ship a broken image.
COPY docs/requirements.txt /tmp/requirements.txt
RUN pip3 install --no-cache-dir -r /tmp/requirements.txt &&\
    rm -f /tmp/requirements.txt &&\
    zensical --version

# Create vscode user
RUN mkdir -p /workspaces/.kube &&\
    useradd -s /bin/bash -d /workspaces vscode &&\
    chown -R vscode:vscode /workspaces

USER vscode

# Make prompt nicer
RUN curl -sL https://raw.githubusercontent.com/git/git/refs/heads/master/contrib/completion/git-prompt.sh \
        -o ~/.git-prompt.sh
COPY .devcontainer/bashrc /workspaces/.bashrc
